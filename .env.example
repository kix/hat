# Идентификатор клиента Telegram OIDC (numeric Bot ID, например: 8586188935)
VITE_TELEGRAM_CLIENT_ID=

# Секрет клиента Telegram OIDC (из @BotFather -> Bot Settings -> Web Login -> Client Secret)
VITE_TELEGRAM_CLIENT_SECRET=

# Юзернейм бота без @ (например: my_hat_bot). Нужен, чтобы кнопка «Итоги дня в
# Telegram» открывала чат с ботом для нажатия Start. Сам токен бота НИКОГДА не
# кладётся сюда — он хранится в Supabase Vault (см. supabase_setup.md).
VITE_TELEGRAM_BOT_USERNAME=
