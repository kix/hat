;; shadow-cljs configuration for claude-hat
{:source-paths ["src/cljs" "test/cljs"]

 :dependencies
 [[reagent "1.2.0"]
  [re-frame "1.4.7"]
  [funcool/promesa "12.0.1"]
  [binaryage/devtools "1.0.7"]]

 :builds
 {:app
  {:target :browser
   :output-dir "public/cljs"
   :asset-path "/cljs"
   :modules {:main {:init-fn hat.core/init!}}
   :devtools {:after-load hat.core/after-load!
              :http-root "public"
              :http-port 8280}}

  :test
  {:target :node-test
   :output-to "out/node-tests.cjs"
   :autorun true}}}

